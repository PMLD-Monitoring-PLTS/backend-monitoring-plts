# ============================================================
# Environment Variables - PLTS Monitoring
# ============================================================

# Database Configuration (TimescaleDB Lokal via Docker Compose)
POSTGRES_DB=plts_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
DB_HOST_PORT=

# Device Ingestion API Key (Digunakan oleh Simulator & Backend)
DEVICE_API_KEY=ESP8266_PLTS_SECRET_KEY

# Superadmin Credentials (Otomatis dibuat saat server start)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=

# Simulator Configuration
INTERVAL_SECONDS=60
SCENARIO=NORMAL
