# ============================================================
# Environment Variables - PLTS Monitoring
# ============================================================

# Database Configuration (Neon Cloud PostgreSQL)
DATABASE_URL=

# Device Ingestion API Key (Digunakan oleh Simulator & Backend)
DEVICE_API_KEY=

# Superadmin Credentials (Otomatis dibuat saat server start)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Simulator Configuration
INTERVAL_SECONDS=60
SCENARIO=NORMAL
